<?xml version="1.0"?>
<ruleset name="Excursion API">
    <description>PHPCS PSR-12 checks for PHP source and tests.</description>
    <file>src</file>
    <file>config</file>
    <file>migrations</file>
    <file>tests</file>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
